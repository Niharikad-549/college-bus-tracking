SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# Leave DATABASE_URL empty for local SQLite. For deployment, prefer hosted PostgreSQL.
DATABASE_URL=

# Optional alternative to DATABASE_URL for local MySQL:
# DB_ENGINE=mysql
# DB_NAME=bus_tracking
# DB_USER=bus_tracking_user
# DB_PASSWORD=your-database-password
# DB_HOST=127.0.0.1
# DB_PORT=3306